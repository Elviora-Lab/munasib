// =============================================================================
//  Elviora — Database Schema
//  Single source of truth (Prisma) → PostgreSQL.
//
//  Conventions:
//   • Tables and columns are snake_case in the DB (via @@map / @map).
//   • Primary keys are UUID v4 generated DB-side (gen_random_uuid()).
//   • Money fields use Decimal(12,2) for storefront and 6 decimals for FX rates.
//   • All timestamps are TIMESTAMPTZ — store UTC, render in user locale.
//   • Foreign keys are explicitly indexed (Postgres does not index FKs by default).
//   • onDelete: Cascade for owned children; SetNull for soft references
//     (e.g. order_items keep their snapshot when product is removed).
//   • Composite uniques and partial indexes are used to guard data integrity
//     (one default address per user, one active cart per session, etc).
// =============================================================================

generator client {
  provider = "prisma-client-js"
  // Output to the default node_modules location keeps imports portable.
}

datasource db {
  provider  = "postgresql"
  // Runtime connection — may be a pooled (PgBouncer/Supabase :6543) URL.
  url       = env("DATABASE_URL")
  // Direct, non-pooled connection used by `prisma migrate` / introspection.
  // Must be set wherever migrations run (CI release step, local dev); the
  // running app itself only needs DATABASE_URL. Point it at DATABASE_URL when
  // that connection is already direct (non-pooled).
  directUrl = env("DIRECT_URL")
}

// =============================================================================
//  ENUMS — business-state vocabularies
// =============================================================================

enum UserRole {
  CUSTOMER
  VIP
  STAFF
  ADMIN
  SUPER_ADMIN

  @@map("user_role")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  FULFILLMENT
  SUPPORT

  @@map("admin_role")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED

  @@map("order_status")
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  VOIDED

  @@map("payment_status")
}

enum PaymentMethod {
  CARD
  PAYPAL
  APPLE_PAY
  GOOGLE_PAY
  KLARNA
  AFTERPAY
  BANK_TRANSFER
  COD

  @@map("payment_method")
}

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
  FAILED

  @@map("shipment_status")
}

enum DiscountType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING

  @@map("discount_type")
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED

  @@map("subscription_status")
}

enum LoyaltyTxType {
  EARNED
  REDEEMED
  EXPIRED
  ADJUSTMENT
  REFERRAL

  @@map("loyalty_tx_type")
}

enum NotificationType {
  ORDER_UPDATE
  PROMOTION
  REVIEW_REQUEST
  SYSTEM
  LOYALTY
  ABANDONED_CART
  NEW_PRODUCT

  @@map("notification_type")
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  REFUNDED

  @@map("return_status")
}

/// Lifecycle of a purchase order. A PO is only editable while DRAFT; from
/// SUBMITTED onwards it is a record of what was ordered.
enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED

  @@map("purchase_order_status")
}

/// Why a variant's stock changed.
enum StockMovementReason {
  OPENING_BALANCE
  PURCHASE_RECEIPT
  SALE
  ORDER_RESTOCK
  ADJUSTMENT
  DAMAGE
  LOSS
  SUPPLIER_RETURN
  IMPORT_SYNC

  @@map("stock_movement_reason")
}

// =============================================================================
//  IDENTITY & ACCESS
// =============================================================================

/// End-customers of the storefront. Operators live in `admin_users`.
model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName    String?   @map("first_name") @db.VarChar(80)
  lastName     String?   @map("last_name") @db.VarChar(80)
  email        String    @unique @db.VarChar(255)
  phone        String?   @db.VarChar(32)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         UserRole  @default(CUSTOMER)
  isVerified   Boolean   @default(false) @map("is_verified")
  profileImage String?   @map("profile_image")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  addresses          UserAddress[]
  carts              Cart[]
  wishlists          Wishlist[]
  orders             Order[]
  reviews            Review[]
  notifications      Notification[]
  recentlyViewed     RecentlyViewedProduct[]
  searchLogs         SearchLog[]
  viewLogs           ProductViewLog[]
  loyaltyPoints      LoyaltyPoint[]
  couponUsages       CouponUsage[]
  subscriptions      Subscription[]
  aiAssessments      AiSkinAssessment[]
  referralsMade      Referral[]              @relation("ReferrerRelation")
  referralsGotten    Referral[]              @relation("ReferredRelation")
  // Audit trail of order-status transitions this user triggered (admin actor).
  orderStatusChanges OrderStatusHistory[]    @relation("OrderStatusChanger")
  refreshTokens      RefreshToken[]
  returnRequests     ReturnRequest[]
  // Stock movements this user posted (admin actor on manual adjustments).
  stockMovements     StockMovement[]
  purchaseOrders     PurchaseOrder[]         @relation("PurchaseOrderCreator")
  goodsReceipts      GoodsReceipt[]          @relation("GoodsReceiptReceiver")

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

/// Server-side record of every issued refresh token, keyed by its JWT `jti`.
/// Enables rotation, revocation (logout), and reuse detection: a refresh JWT is
/// only honored if its `jti` row exists, is not revoked, and is not expired.
model RefreshToken {
  jti        String    @id @db.VarChar(64)
  userId     String    @map("user_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  // jti of the token that superseded this one (set on rotation); aids auditing.
  replacedBy String?   @map("replaced_by") @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Saved shipping / billing addresses. A user may have many; exactly one
/// per user may be flagged default (enforced by a partial unique index).
model UserAddress {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  fullName     String   @map("full_name") @db.VarChar(160)
  phone        String?  @db.VarChar(32)
  country      String   @db.VarChar(2) // ISO-3166 alpha-2
  city         String   @db.VarChar(120)
  area         String?  @db.VarChar(160)
  addressLine1 String   @map("address_line_1") @db.VarChar(255)
  addressLine2 String?  @map("address_line_2") @db.VarChar(255)
  postalCode   String?  @map("postal_code") @db.VarChar(20)
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // "At most one default address per user" is enforced by a PARTIAL unique
  // index (`WHERE is_default`) created in the migration. Prisma can't express
  // partial unique constraints in the schema, so it isn't declared with
  // @@unique here — a plain composite unique on (userId, isDefault) would
  // wrongly cap each user at two addresses (one default + one non-default).
  @@index([userId])
  @@map("user_addresses")
}

/// Operators (back-office). Separated from `users` so we can apply distinct
/// security policies (MFA, IP restriction, narrower password rules).
model AdminUser {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String    @db.VarChar(160)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         AdminRole @default(EDITOR)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  activityLogs AdminActivityLog[]

  @@index([role])
  @@map("admin_users")
}

/// Append-only audit log for back-office actions.
model AdminActivityLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminUserId String   @map("admin_user_id") @db.Uuid
  action      String   @db.VarChar(64) // e.g. "update", "delete"
  module      String   @db.VarChar(64) // e.g. "products", "orders"
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([module, createdAt])
  @@map("admin_activity_logs")
}

// =============================================================================
//  CATALOG
// =============================================================================

/// Self-referential category tree (Skincare → Serums → Vitamin C, etc).
model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  name        String   @db.VarChar(160)
  slug        String   @unique @db.VarChar(180)
  description String?  @db.Text
  image       String?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  parent          Category?         @relation("CategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[]        @relation("CategoryParent")
  /// Products whose PRIMARY category this is (drives breadcrumbs, feeds).
  products        Product[]
  /// Full membership, primary included — see ProductCategory.
  productMappings ProductCategory[]

  @@index([parentId])
  @@index([isActive, sortOrder])
  @@map("categories")
}

/// Many-to-many product↔category membership. A product can be merchandised in
/// several categories at once (e.g. "Kitchen Accessories" AND "Random Gadgets"),
/// which `Product.categoryId` alone cannot express.
///
/// `Product.categoryId` remains the PRIMARY category — the single one used for
/// breadcrumbs, the product feed, and admin editing. This table holds the FULL
/// set INCLUDING that primary, so category listing queries can filter on it
/// alone without unioning the scalar column.
model ProductCategory {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId  String @map("product_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId], map: "uq_product_category")
  @@index([categoryId])
  @@map("product_categories")
}

model Brand {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String  @db.VarChar(160)
  slug        String  @unique @db.VarChar(180)
  logo        String?
  description String? @db.Text
  isActive    Boolean @default(true) @map("is_active")

  products Product[]

  @@index([isActive])
  @@map("brands")
}

/// Master product. SKU/barcode/slug are all unique. Pricing here is the
/// "from" price; actual transactable price lives on `product_variants`.
model Product {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId       String?  @map("category_id") @db.Uuid
  brandId          String?  @map("brand_id") @db.Uuid
  name             String   @db.VarChar(255)
  slug             String   @unique @db.VarChar(255)
  shortDescription String?  @map("short_description") @db.VarChar(500)
  fullDescription  String?  @map("full_description") @db.Text
  sku              String   @unique @db.VarChar(80)
  barcode          String?  @unique @db.VarChar(64)
  price            Decimal  @db.Decimal(12, 2)
  comparePrice     Decimal? @map("compare_price") @db.Decimal(12, 2)
  costPrice        Decimal? @map("cost_price") @db.Decimal(12, 2)
  isFeatured       Boolean  @default(false) @map("is_featured")
  isActive         Boolean  @default(true) @map("is_active")
  seoTitle         String?  @map("seo_title") @db.VarChar(255)
  seoDescription   String?  @map("seo_description") @db.VarChar(500)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  /// Primary category — breadcrumbs, feeds, admin. Full set lives in `categories`.
  category           Category?               @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categories         ProductCategory[]
  brand              Brand?                  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants           ProductVariant[]
  images             ProductImage[]
  tagMappings        ProductTagMapping[]
  skinConcerns       ProductSkinConcern[]
  ingredients        ProductIngredient[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  wishlists          Wishlist[]
  reviews            Review[]
  recentlyViewed     RecentlyViewedProduct[]
  viewLogs           ProductViewLog[]
  stockNotifications StockNotification[]
  flashSaleItems     FlashSaleItem[]

  // CHECK constraints — non-negative pricing.
  @@index([categoryId])
  @@index([brandId])
  @@index([isActive])
  @@index([isFeatured, isActive])
  @@index([createdAt])
  // Price-range filters on the catalog listing.
  @@index([price])
  // Trigram (GIN) index on `name` for fuzzy search lives in raw SQL —
  // 20260719010000_add_analytics_and_catalog_indexes — Prisma can't express it.
  @@map("products")
}

/// A purchasable variant of a product: 30ml / 50ml, shade "Rose", etc.
/// Stock is held here, not on the master product.
model ProductVariant {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  size          String?  @db.VarChar(64)
  shade         String?  @db.VarChar(64)
  fragrance     String?  @db.VarChar(64)
  sku           String   @unique @db.VarChar(80)
  price         Decimal  @db.Decimal(12, 2)
  /// Cached on-hand quantity. Authoritative history lives in `stock_movements`;
  /// write to it only through `inventory.service.ts`, never directly.
  stockQuantity Int      @default(0) @map("stock_quantity")
  weight        Decimal? @db.Decimal(8, 3) // kilograms — for shipping rate calc
  isActive      Boolean  @default(true) @map("is_active")

  /// Reorder trigger. Null falls back to the global default in `app_settings`.
  reorderPoint    Int?     @map("reorder_point")
  /// How many to buy when the point is hit — the suggested order quantity.
  reorderQuantity Int?     @map("reorder_quantity")
  /// Moving-average landed cost, recalculated on every goods receipt. This is
  /// the basis for inventory valuation and margin, not `products.cost_price`.
  avgCost         Decimal? @map("avg_cost") @db.Decimal(12, 2)

  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  images             ProductImage[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  stockNotifications StockNotification[]
  stockMovements     StockMovement[]
  supplierLinks      SupplierVariant[]
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems  GoodsReceiptItem[]

  @@index([productId])
  @@index([isActive])
  @@index([stockQuantity])
  @@map("product_variants")
}

/// Product gallery. Image may be attached to a variant (e.g. swatch) or to
/// the master product (lifestyle, packshot).
model ProductImage {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  variantId String? @map("variant_id") @db.Uuid
  imageUrl  String  @map("image_url")
  altText   String? @map("alt_text") @db.VarChar(255)
  isPrimary Boolean @default(false) @map("is_primary")
  sortOrder Int     @default(0) @map("sort_order")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@index([variantId])
  @@map("product_images")
}

/// Free-form, merchandiser-controlled product tags ("New", "Vegan", "Editor's pick").
model ProductTag {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @db.VarChar(80)
  slug String @unique @db.VarChar(100)

  productMappings ProductTagMapping[]

  @@map("product_tags")
}

model ProductTagMapping {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String @map("product_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     ProductTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([productId, tagId], map: "uq_product_tag")
  @@index([tagId])
  @@map("product_tag_mappings")
}

// =============================================================================
//  INVENTORY — Stock ledger
// =============================================================================

/// Append-only record of every change to a variant's stock.
///
/// This is the source of truth; `product_variants.stock_quantity` is a cache
/// kept in step within the same transaction (the storefront, feeds and the
/// low-stock index all read the column, so it can't be dropped). The two are
/// reconcilable at any time: `SUM(delta)` per variant must equal the column.
///
/// Rows are never updated or deleted. A mistake is corrected by posting a
/// compensating movement, which is what makes the history auditable.
model StockMovement {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId    String              @map("variant_id") @db.Uuid
  /// Signed change: -3 sold, +50 received. Never zero.
  delta        Int
  /// The variant's resulting stock, so history reads without a window function.
  balanceAfter Int                 @map("balance_after")
  reason       StockMovementReason
  /// What caused it — "ORDER", "MANUAL", "IMPORT" (later "GOODS_RECEIPT").
  /// Deliberately a plain string, mirroring `click_event_logs.target_type`.
  refType      String?             @map("ref_type") @db.VarChar(24)
  refId        String?             @map("ref_id") @db.Uuid
  /// Cost per unit at the time of the movement — the basis for valuation once
  /// purchasing lands. Null for movements with no known cost (sales, restocks).
  unitCost     Decimal?            @map("unit_cost") @db.Decimal(12, 2)
  note         String?             @db.Text
  createdBy    String?             @map("created_by") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  actor   User?          @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([refType, refId])
  @@index([reason, createdAt])
  @@map("stock_movements")
}

// =============================================================================
//  PURCHASING — Suppliers, purchase orders, goods receipts
// =============================================================================

/// Who stock is bought from. Deliberately separate from `brands`: one supplier
/// carries many brands, and the same brand may come from several distributors.
/// The two are related only through what actually gets ordered.
model Supplier {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String   @db.VarChar(160)
  slug         String   @unique @db.VarChar(180)
  contactName  String?  @map("contact_name") @db.VarChar(160)
  email        String?  @db.VarChar(255)
  phone        String?  @db.VarChar(32)
  address      String?  @db.Text
  /// Free text — "Net 30", "50% advance", "COD".
  paymentTerms String?  @map("payment_terms") @db.VarChar(64)
  /// Typical days from order to delivery; drives suggested reorder timing.
  leadTimeDays Int?     @map("lead_time_days")
  notes        String?  @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  purchaseOrders PurchaseOrder[]
  variants       SupplierVariant[]

  @@index([isActive])
  @@map("suppliers")
}

/// What a given supplier charges for a given variant, under their own SKU.
/// Prefills purchase-order lines and tells the low-stock report who to reorder
/// from, so buying doesn't depend on someone remembering last quarter's price.
model SupplierVariant {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId       String   @map("supplier_id") @db.Uuid
  variantId        String   @map("variant_id") @db.Uuid
  supplierSku      String?  @map("supplier_sku") @db.VarChar(80)
  unitCost         Decimal? @map("unit_cost") @db.Decimal(12, 2)
  minOrderQuantity Int?     @map("min_order_quantity")
  /// At most one preferred supplier per variant (partial unique index in SQL).
  isPreferred      Boolean  @default(false) @map("is_preferred")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  supplier Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([supplierId, variantId], map: "uq_supplier_variant")
  @@index([variantId])
  @@map("supplier_variants")
}

/// An order placed with a supplier. Line totals are derived from the items
/// rather than stored, so they cannot drift; only the charges that arrive
/// separately from the line prices are held here.
model PurchaseOrder {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId   String              @map("supplier_id") @db.Uuid
  poNumber     String              @unique @map("po_number") @db.VarChar(32)
  status       PurchaseOrderStatus @default(DRAFT)
  currency     String              @default("PKR") @db.VarChar(3)
  expectedAt   DateTime?           @map("expected_at") @db.Timestamptz
  /// Charges levied on the order as a whole. Spread across received lines by
  /// value to give each unit a landed cost — see `purchasing.service.ts`.
  shippingCost Decimal             @default(0) @map("shipping_cost") @db.Decimal(12, 2)
  dutyCost     Decimal             @default(0) @map("duty_cost") @db.Decimal(12, 2)
  otherCost    Decimal             @default(0) @map("other_cost") @db.Decimal(12, 2)
  notes        String?             @db.Text
  createdBy    String?             @map("created_by") @db.Uuid
  submittedAt  DateTime?           @map("submitted_at") @db.Timestamptz
  closedAt     DateTime?           @map("closed_at") @db.Timestamptz
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  supplier Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  creator  User?               @relation("PurchaseOrderCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  items    PurchaseOrderItem[]
  receipts GoodsReceipt[]

  @@index([supplierId])
  @@index([status, createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseOrderId  String  @map("purchase_order_id") @db.Uuid
  variantId        String  @map("variant_id") @db.Uuid
  quantityOrdered  Int     @map("quantity_ordered")
  /// Running total across receipts; never exceeds `quantity_ordered`.
  quantityReceived Int     @default(0) @map("quantity_received")
  unitCost         Decimal @map("unit_cost") @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict)
  receiptItems  GoodsReceiptItem[]

  @@unique([purchaseOrderId, variantId], map: "uq_po_variant")
  @@index([variantId])
  @@map("purchase_order_items")
}

/// One delivery against a purchase order. A PO may be received in several
/// drops; each one credits stock and stamps a landed cost.
model GoodsReceipt {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz
  receivedBy      String?  @map("received_by") @db.Uuid
  note            String?  @db.Text

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  receiver      User?              @relation("GoodsReceiptReceiver", fields: [receivedBy], references: [id], onDelete: SetNull)
  items         GoodsReceiptItem[]

  @@index([purchaseOrderId, receivedAt])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  goodsReceiptId      String  @map("goods_receipt_id") @db.Uuid
  purchaseOrderItemId String  @map("purchase_order_item_id") @db.Uuid
  variantId           String  @map("variant_id") @db.Uuid
  quantity            Int
  /// Line cost plus this line's share of the order's shipping and duty. This
  /// is the figure that feeds the variant's moving-average cost.
  unitLandedCost      Decimal @map("unit_landed_cost") @db.Decimal(12, 2)

  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Cascade)
  variant           ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([goodsReceiptId])
  @@index([purchaseOrderItemId])
  @@index([variantId])
  @@map("goods_receipt_items")
}

// =============================================================================
//  COSMETICS-SPECIFIC ATTRIBUTES
// =============================================================================

/// Skincare concerns powering filters and the AI assistant
/// (Acne, Hyperpigmentation, Aging, Sensitivity, ...).
model SkinConcern {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @db.VarChar(120)
  slug String @unique @db.VarChar(140)

  products ProductSkinConcern[]

  @@map("skin_concerns")
}

model ProductSkinConcern {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId     String @map("product_id") @db.Uuid
  skinConcernId String @map("skin_concern_id") @db.Uuid

  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  skinConcern SkinConcern @relation(fields: [skinConcernId], references: [id], onDelete: Cascade)

  @@unique([productId, skinConcernId], map: "uq_product_skin_concern")
  @@index([skinConcernId])
  @@map("product_skin_concerns")
}

/// INCI ingredient registry — feeds product detail pages and "free from" filters.
model Ingredient {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String  @db.VarChar(160)
  slug        String  @unique @db.VarChar(180)
  description String? @db.Text

  products ProductIngredient[]

  @@map("ingredients")
}

model ProductIngredient {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId    String @map("product_id") @db.Uuid
  ingredientId String @map("ingredient_id") @db.Uuid

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([productId, ingredientId], map: "uq_product_ingredient")
  @@index([ingredientId])
  @@map("product_ingredients")
}

// =============================================================================
//  COMMERCE — Cart, Wishlist
// =============================================================================

/// A cart belongs to a logged-in user OR (for guests) a session_id.
/// Exactly one is required — enforced by a CHECK constraint at the DB layer.
model Cart {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String?   @map("user_id") @db.Uuid
  sessionId      String?   @map("session_id") @db.VarChar(80)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  // When the last abandoned-cart recovery email was sent. Null until a reminder
  // is sent; the cart becomes re-eligible once it changes after this time.
  reminderSentAt DateTime? @map("reminder_sent_at") @db.Timestamptz

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@unique([userId], map: "uq_user_active_cart")
  @@unique([sessionId], map: "uq_session_active_cart")
  @@index([updatedAt])
  @@map("carts")
}

/// Cart line. `price` is the price snapshot at time-of-add — protects the
/// shopper from price changes between viewing and checkout.
model CartItem {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId    String  @map("cart_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  variantId String? @map("variant_id") @db.Uuid
  quantity  Int     @default(1)
  price     Decimal @db.Decimal(12, 2)

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([cartId, productId, variantId], map: "uq_cart_line")
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

model Wishlist {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId], map: "uq_wishlist_user_product")
  @@index([productId])
  @@map("wishlists")
}

/// "Notify me when back in stock" waitlist for an out-of-stock variant. Works
/// for guests (email only) and logged-in users. One row per (variant, email);
/// `notifiedAt` is set once the restock email is sent.
model StockNotification {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId  String    @map("variant_id") @db.Uuid
  productId  String    @map("product_id") @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  email      String    @db.VarChar(255)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  notifiedAt DateTime? @map("notified_at") @db.Timestamptz

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([variantId, email], map: "uq_stock_notify")
  @@index([variantId, notifiedAt])
  @@map("stock_notifications")
}

// =============================================================================
//  COMMERCE — Orders, Payments, Shipments
// =============================================================================

/// Customer-facing order. `order_number` is a human-readable identifier
/// (e.g. "ELV-2026-000142") generated in application code; `id` is the PK.
model Order {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String?       @map("user_id") @db.Uuid
  orderNumber     String        @unique @map("order_number") @db.VarChar(32)
  orderStatus     OrderStatus   @default(PENDING) @map("order_status")
  paymentStatus   PaymentStatus @default(PENDING) @map("payment_status")
  subtotal        Decimal       @db.Decimal(12, 2)
  shippingFee     Decimal       @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  taxAmount       Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  /// Human label for the applied discount ("Spend & Save", a coupon code, …) —
  /// null when no discount. Lets receipts/admin show the source without a join.
  discountLabel   String?       @map("discount_label") @db.VarChar(64)
  totalAmount     Decimal       @map("total_amount") @db.Decimal(12, 2)
  currency        String        @default("PKR") @db.VarChar(3)
  notes           String?       @db.Text
  /// Set exactly once when a cancel/return/refund restores this order's stock,
  /// so concurrent paths (admin action, Stripe webhook) can't double-restock.
  stockRestoredAt DateTime?     @map("stock_restored_at") @db.Timestamptz
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz

  // ---- Shipping address snapshot ----------------------------------------
  // Denormalized inline so the order stays immutable even if the customer
  // later edits or deletes the source UserAddress. All fields are nullable
  // for backward-compat with historic test orders placed before this column
  // set existed; new orders populate them via `placeOrder`.
  shippingFullName     String? @map("shipping_full_name") @db.VarChar(160)
  shippingEmail        String? @map("shipping_email") @db.VarChar(255)
  shippingPhone        String? @map("shipping_phone") @db.VarChar(32)
  shippingCountry      String? @map("shipping_country") @db.VarChar(2)
  shippingCity         String? @map("shipping_city") @db.VarChar(120)
  shippingArea         String? @map("shipping_area") @db.VarChar(160)
  shippingAddressLine1 String? @map("shipping_address_line_1") @db.VarChar(255)
  shippingAddressLine2 String? @map("shipping_address_line_2") @db.VarChar(255)
  shippingPostalCode   String? @map("shipping_postal_code") @db.VarChar(20)

  // ---- Marketing attribution (last-touch, captured at checkout) -----------
  // utm_* from the landing URL via the elv_utm cookie. Powers first-party
  // campaign filtering on /admin/pixel (which campaign drove the sale/revenue).
  utmSource   String? @map("utm_source") @db.VarChar(120)
  utmMedium   String? @map("utm_medium") @db.VarChar(120)
  utmCampaign String? @map("utm_campaign") @db.VarChar(160)

  user          User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]
  shipments     Shipment[]
  couponUsages  CouponUsage[]
  returnRequest ReturnRequest?

  @@index([userId])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([userId, createdAt])
  // Geographic sales breakdowns (admin analytics).
  @@index([shippingCity])
  @@index([shippingArea])
  @@map("orders")
}

/// Customer-initiated return / refund request for a delivered order. One per
/// order (v1, order-level). The admin moves it through REQUESTED → APPROVED →
/// REFUNDED (or REJECTED); marking REFUNDED also flips the order to REFUNDED.
model ReturnRequest {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId    String       @unique @map("order_id") @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  status     ReturnStatus @default(REQUESTED)
  reason     String       @db.VarChar(120)
  comment    String?      @db.Text
  adminNote  String?      @map("admin_note") @db.Text
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  resolvedAt DateTime?    @map("resolved_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId])
  @@map("return_requests")
}

/// Order line item. We snapshot `product_name`, `variant_name`, `unit_price`
/// so the order is immutable even if the catalog changes later.
model OrderItem {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String  @map("order_id") @db.Uuid
  productId   String? @map("product_id") @db.Uuid
  variantId   String? @map("variant_id") @db.Uuid
  productName String  @map("product_name") @db.VarChar(255)
  variantName String? @map("variant_name") @db.VarChar(255)
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  totalPrice  Decimal @map("total_price") @db.Decimal(12, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

/// Status-change audit trail for every order.
model OrderStatusHistory {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String      @map("order_id") @db.Uuid
  status    OrderStatus
  note      String?     @db.Text
  /// Actor who triggered the change. Points to `users.id` (admins live in the
  /// users table — `users.role` ∈ {ADMIN, SUPER_ADMIN, STAFF}). Nullable for
  /// system / webhook-driven transitions (e.g. payment-succeeded → CONFIRMED).
  changedBy String?     @map("changed_by") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz

  order         Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByUser User? @relation("OrderStatusChanger", fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

/// One row per payment attempt; an order can have multiple (auth, capture,
/// refund) so we don't overwrite history.
model Payment {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId       String        @map("order_id") @db.Uuid
  paymentMethod PaymentMethod @map("payment_method")
  transactionId String?       @unique @map("transaction_id") @db.VarChar(120)
  amount        Decimal       @db.Decimal(12, 2)
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  paidAt        DateTime?     @map("paid_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([paymentStatus])
  @@map("payments")
}

/// Carrier dispatch + tracking. One order may ship in multiple parcels.
model Shipment {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId            String         @map("order_id") @db.Uuid
  courierName        String         @map("courier_name") @db.VarChar(120)
  trackingNumber     String?        @unique @map("tracking_number") @db.VarChar(120)
  shipmentStatus     ShipmentStatus @default(PENDING) @map("shipment_status")
  trackingStatusText String?        @map("tracking_status_text") @db.VarChar(120)
  trackingJourney    String?        @map("tracking_journey") @db.VarChar(255)
  trackingSyncedAt   DateTime?      @map("tracking_synced_at") @db.Timestamptz
  shippedAt          DateTime?      @map("shipped_at") @db.Timestamptz
  deliveredAt        DateTime?      @map("delivered_at") @db.Timestamptz
  /// When the courier booking / shipment row was created (book time).
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz
  /// Kitchen printed PostEx AWB or internal shipping labels.
  labelPrintedAt     DateTime?      @map("label_printed_at") @db.Timestamptz
  labelPrintedBy     String?        @map("label_printed_by") @db.Uuid
  /// Staff marked the parcel packed / arranged.
  packedAt           DateTime?      @map("packed_at") @db.Timestamptz
  packedBy           String?        @map("packed_by") @db.Uuid
  /// Denormalized invoice payload (lines + image URLs) captured at book time
  /// so Invoice+AWB print avoids deep catalog joins on every pack.
  printSnapshot      Json?          @map("print_snapshot")
  /// PostEx AWB PDF bytes captured at book time so print skips the courier API.
  awbPdf             Bytes?         @map("awb_pdf")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([shipmentStatus])
  @@index([createdAt])
  @@index([labelPrintedAt])
  @@index([packedAt])
  @@map("shipments")
}

// =============================================================================
//  REVIEWS & UGC
// =============================================================================

/// Product review. Star rating is constrained to 1-5 via CHECK.
/// `is_verified_purchase` is set at write time after looking up the order_items.
model Review {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Null for verified-purchase GUEST reviews (accounts are optional). A guest
  /// review is instead bound to its purchase via `orderId` + `authorName`.
  userId             String?  @map("user_id") @db.Uuid
  /// The order this review is for — set on guest reviews. No FK (analytics-style:
  /// deleting an order must not cascade-remove its reviews). Enforces one review
  /// per (order, product) via the unique index below.
  orderId            String?  @map("order_id") @db.Uuid
  /// Display name for guest reviews (taken from the order's shipping name).
  authorName         String?  @map("author_name") @db.VarChar(160)
  productId          String   @map("product_id") @db.Uuid
  rating             Int
  title              String?  @db.VarChar(200)
  comment            String?  @db.Text
  isVerifiedPurchase Boolean  @default(false) @map("is_verified_purchase")
  isApproved         Boolean  @default(false) @map("is_approved") // moderation gate
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  user    User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  images  ReviewImage[]

  @@unique([userId, productId], map: "uq_review_user_product")
  @@unique([orderId, productId], map: "uq_review_order_product")
  @@index([productId, isApproved])
  @@index([createdAt])
  @@map("reviews")
}

model ReviewImage {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewId String @map("review_id") @db.Uuid
  imageUrl String @map("image_url")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_images")
}

// =============================================================================
//  MARKETING — Coupons, Banners, Blog, Newsletter
// =============================================================================

model Coupon {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String       @unique @db.VarChar(64)
  discountType       DiscountType @map("discount_type")
  discountValue      Decimal      @map("discount_value") @db.Decimal(12, 2)
  minimumOrderAmount Decimal?     @map("minimum_order_amount") @db.Decimal(12, 2)
  maximumDiscount    Decimal?     @map("maximum_discount") @db.Decimal(12, 2)
  usageLimit         Int?         @map("usage_limit") // null = unlimited
  usedCount          Int          @default(0) @map("used_count")
  startsAt           DateTime?    @map("starts_at") @db.Timestamptz
  expiresAt          DateTime?    @map("expires_at") @db.Timestamptz
  isActive           Boolean      @default(true) @map("is_active")

  usages CouponUsage[]

  @@index([isActive, expiresAt])
  @@map("coupons")
}

/// One row per redemption — used to enforce per-user usage caps.
model CouponUsage {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  couponId String   @map("coupon_id") @db.Uuid
  userId   String?  @map("user_id") @db.Uuid
  orderId  String?  @map("order_id") @db.Uuid
  usedAt   DateTime @default(now()) @map("used_at") @db.Timestamptz

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([couponId])
  @@index([userId])
  @@index([orderId])
  @@map("coupon_usages")
}

/// "Spend & Save" — automatic, cart-level discount tiers. When the subtotal
/// reaches `minSubtotal`, `discountAmount` comes off. The highest qualifying
/// active tier wins; the app compares it against any coupon and applies the
/// larger (best-single-wins). Managed from /admin/coupons.
model SpendDiscountTier {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  minSubtotal    Decimal  @map("min_subtotal") @db.Decimal(12, 2)
  discountAmount Decimal  @map("discount_amount") @db.Decimal(12, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([isActive, minSubtotal])
  @@map("spend_discount_tiers")
}

/// Generic key/value store for store-wide toggles (e.g. the Spend & Save
/// master switch, `spend_discount.enabled`). Small, reusable — not per-user.
model AppSetting {
  key       String   @id @db.VarChar(64)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("app_settings")
}

/// Homepage flash sale — a scheduled window during which a curated set of
/// products sells at a reduced price. At most one sale is live at a time
/// (enforced in `flash-sale.actions.ts`, not by a constraint, so an admin can
/// stage the next sale while the current one runs).
///
/// The discount is a PERCENTAGE, not an absolute price, because the chargeable
/// price lives on ProductVariant and a product can have several variants at
/// different prices — a single absolute price would be wrong for all but one.
model FlashSale {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String   @default("Flash Sale") @db.VarChar(120)
  /// Inclusive start / exclusive end of the selling window.
  startsAt  DateTime @map("starts_at") @db.Timestamptz
  endsAt    DateTime @map("ends_at") @db.Timestamptz
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  items FlashSaleItem[]

  @@index([isActive, startsAt, endsAt])
  @@map("flash_sales")
}

/// One curated product in a flash sale. Capped at MAX_FLASH_SALE_ITEMS (16) per
/// sale by the server action. `position` drives homepage display order.
model FlashSaleItem {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  flashSaleId     String @map("flash_sale_id") @db.Uuid
  productId       String @map("product_id") @db.Uuid
  /// Whole-percent discount off each variant's price. CHECK (1..90) in the migration.
  discountPercent Int    @map("discount_percent")
  position        Int    @default(0)

  flashSale FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([flashSaleId, productId])
  @@index([flashSaleId, position])
  @@map("flash_sale_items")
}

model Banner {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String    @db.VarChar(200)
  imageUrl    String    @map("image_url")
  redirectUrl String?   @map("redirect_url")
  position    String    @db.VarChar(64) // e.g. "homepage_hero", "category_top"
  isActive    Boolean   @default(true) @map("is_active")
  startsAt    DateTime? @map("starts_at") @db.Timestamptz
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz

  @@index([position, isActive])
  @@index([isActive, expiresAt])
  @@map("banners")
}

model BlogCategory {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @db.VarChar(160)
  slug String @unique @db.VarChar(180)

  posts BlogPost[]

  @@map("blog_categories")
}

model BlogPost {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId     String?   @map("category_id") @db.Uuid
  title          String    @db.VarChar(255)
  slug           String    @unique @db.VarChar(255)
  thumbnail      String?
  content        String    @db.Text
  seoTitle       String?   @map("seo_title") @db.VarChar(255)
  seoDescription String?   @map("seo_description") @db.VarChar(500)
  isPublished    Boolean   @default(false) @map("is_published")
  publishedAt    DateTime? @map("published_at") @db.Timestamptz

  category BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([isPublished, publishedAt])
  @@map("blog_posts")
}

model NewsletterSubscriber {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique @db.VarChar(255)
  isActive     Boolean  @default(true) @map("is_active")
  subscribedAt DateTime @default(now()) @map("subscribed_at") @db.Timestamptz

  @@index([isActive])
  @@index([subscribedAt])
  @@map("newsletter_subscribers")
}

// =============================================================================
//  NOTIFICATIONS
// =============================================================================

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(200)
  message   String           @db.Text
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model MarketingVisitor {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Browser-visible anonymous id stored in localStorage/cookie. Not PII.
  anonymousId            String    @unique @map("anonymous_id") @db.VarChar(64)
  /// HttpOnly guest-session anchor, when the server has minted one.
  guestId                String?   @unique @map("guest_id") @db.VarChar(64)
  userId                 String?   @map("user_id") @db.Uuid
  cartId                 String?   @map("cart_id") @db.Uuid
  fbp                    String?   @db.VarChar(255)
  fbc                    String?   @db.VarChar(255)
  utmSource              String?   @map("utm_source") @db.VarChar(120)
  utmMedium              String?   @map("utm_medium") @db.VarChar(120)
  utmCampaign            String?   @map("utm_campaign") @db.VarChar(160)
  utmContent             String?   @map("utm_content") @db.VarChar(160)
  utmTerm                String?   @map("utm_term") @db.VarChar(160)
  firstPath              String?   @map("first_path") @db.VarChar(512)
  lastPath               String?   @map("last_path") @db.VarChar(512)
  referrer               String?   @db.VarChar(512)
  deviceType             String?   @map("device_type") @db.VarChar(32)
  notificationPermission String    @default("default") @map("notification_permission") @db.VarChar(16)
  intentScore            Int       @default(0) @map("intent_score")
  firstSeenAt            DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz
  lastSeenAt             DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  pushSubscribedAt       DateTime? @map("push_subscribed_at") @db.Timestamptz

  pushTokens WebPushToken[]

  @@index([guestId])
  @@index([userId])
  @@index([cartId])
  @@index([intentScore, lastSeenAt])
  @@index([lastSeenAt])
  @@map("marketing_visitors")
}

model WebPushToken {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visitorId              String    @map("visitor_id") @db.Uuid
  token                  String    @unique @db.Text
  firebaseInstallationId String?   @map("firebase_installation_id") @db.VarChar(128)
  permission             String    @default("granted") @db.VarChar(16)
  platform               String?   @db.VarChar(64)
  userAgent              String?   @map("user_agent") @db.VarChar(512)
  isActive               Boolean   @default(true) @map("is_active")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  lastSeenAt             DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  revokedAt              DateTime? @map("revoked_at") @db.Timestamptz

  visitor MarketingVisitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([visitorId, isActive])
  @@index([isActive, lastSeenAt])
  @@map("web_push_tokens")
}

// =============================================================================
//  ANALYTICS — write-heavy logs
// =============================================================================

/// Last-N viewed products per user. App layer trims to a fixed window
/// (e.g. 20 newest) on insert.
model RecentlyViewedProduct {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  viewedAt  DateTime @default(now()) @map("viewed_at") @db.Timestamptz

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId], map: "uq_recently_viewed_user_product")
  @@index([userId, viewedAt(sort: Desc)])
  @@map("recently_viewed_products")
}

/// Search-bar query log. Powers "trending" and zero-result analysis.
model SearchLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  keyword     String   @db.VarChar(255)
  resultCount Int      @default(0) @map("result_count")
  searchedAt  DateTime @default(now()) @map("searched_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([keyword])
  @@index([searchedAt])
  @@index([userId, searchedAt])
  @@map("search_logs")
}

/// Granular pageview log — high volume. Consider partitioning by month
/// in production via a migration that adds PARTITION BY RANGE (viewed_at).
model ProductViewLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  viewedAt  DateTime @default(now()) @map("viewed_at") @db.Timestamptz

  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, viewedAt])
  @@index([userId, viewedAt])
  // Time-window scans (funnel counts, "views in the last N days").
  @@index([viewedAt])
  @@map("product_view_logs")
}

/// Append-only log of "add to cart" events, for merchandising analytics.
/// Relation-less (plain id columns): analytics tolerates orphaned rows and we
/// join product details at query time, so product/variant deletion needn't
/// cascade here.
model CartEventLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  variantId String?  @map("variant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([productId, createdAt])
  @@index([userId, createdAt])
  // Time-window scans (funnel counts, "cart adds in the last N days").
  @@index([createdAt])
  @@map("cart_event_logs")
}

/// Append-only first-party clickstream — "who clicked what, when". High volume,
/// so it's deliberately narrow and relation-less (plain id columns, joined at
/// query time) like CartEventLog: analytics tolerates orphaned rows and we don't
/// want product/user deletion to cascade-scan this table. A retention job trims
/// rows older than CLICKSTREAM_RETENTION_DAYS; consider monthly
/// PARTITION BY RANGE (created_at) via a migration if volume warrants.
model ClickEventLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Logged-in user, when known. No FK so a user delete needn't touch this table.
  userId     String?  @map("user_id") @db.Uuid
  /// Guest-session anchor (elv_guest cookie) for pre-login attribution.
  guestId    String?  @map("guest_id") @db.VarChar(64)
  /// Semantic bucket: product | nav | cta | banner | link | button | other.
  targetType String   @map("target_type") @db.VarChar(24)
  /// Stable id for the thing clicked (productId, or a data-track-id). Null when
  /// the element carries no explicit id.
  targetId   String?  @map("target_id") @db.VarChar(128)
  /// Human label (trimmed text / aria-label / data-track-label), PII-stripped.
  label      String?  @db.VarChar(160)
  /// Destination for links (query string stripped). Null for buttons.
  href       String?  @db.VarChar(512)
  /// Path where the click happened (location.pathname).
  pagePath   String   @map("page_path") @db.VarChar(512)
  /// Index within a list/grid, when the element exposes data-index.
  position   Int?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([createdAt])
  @@index([targetType, createdAt])
  @@index([targetId, createdAt])
  @@index([userId, createdAt])
  @@map("click_event_logs")
}

/// Zero-party data — answers to on-site micro-surveys ("why didn't you buy?",
/// "how did you hear about us?"). The qualitative *why* that behavioural logs
/// can't capture. Relation-less like the other logs.
model SurveyResponse {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Which survey fired: exit_intent | post_purchase.
  kind      String   @db.VarChar(32)
  /// Question key (e.g. why_not_buy, how_heard).
  question  String   @db.VarChar(64)
  /// Chosen option label or free text.
  answer    String   @db.VarChar(500)
  userId    String?  @map("user_id") @db.Uuid
  guestId   String?  @map("guest_id") @db.VarChar(64)
  orderId   String?  @map("order_id") @db.Uuid
  pagePath  String?  @map("page_path") @db.VarChar(512)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([kind, createdAt])
  @@index([question, answer])
  @@map("survey_responses")
}

model VisitorEventLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visitorId  String?  @map("visitor_id") @db.Uuid
  guestId    String?  @map("guest_id") @db.VarChar(64)
  eventName  String   @map("event_name") @db.VarChar(64)
  productId  String?  @map("product_id") @db.Uuid
  variantId  String?  @map("variant_id") @db.Uuid
  cartId     String?  @map("cart_id") @db.Uuid
  value      Decimal? @db.Decimal(12, 2)
  currency   String?  @db.VarChar(3)
  scoreDelta Int      @default(0) @map("score_delta")
  pagePath   String?  @map("page_path") @db.VarChar(512)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([visitorId, createdAt])
  @@index([guestId, createdAt])
  @@index([eventName, createdAt])
  @@index([productId, createdAt])
  @@map("visitor_event_logs")
}

model ProductNotificationSubscription {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visitorId String    @map("visitor_id") @db.Uuid
  productId String    @map("product_id") @db.Uuid
  variantId String?   @map("variant_id") @db.Uuid
  type      String    @db.VarChar(32)
  status    String    @default("ACTIVE") @db.VarChar(16)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  endedAt   DateTime? @map("ended_at") @db.Timestamptz

  @@unique([visitorId, productId, variantId, type], map: "uq_product_push_subscription")
  @@index([productId, type, status])
  @@index([visitorId, status])
  @@map("product_notification_subscriptions")
}

// =============================================================================
//  LOYALTY, REFERRALS, SUBSCRIPTIONS
// =============================================================================

/// Append-only ledger of points changes. Current balance =
/// SUM(points) for a user. Type makes the change semantically queryable.
model LoyaltyPoint {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  points          Int // signed: + earned / − redeemed
  transactionType LoyaltyTxType @map("transaction_type")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("loyalty_points")
}

model Referral {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referrerUserId String   @map("referrer_user_id") @db.Uuid
  referredUserId String   @map("referred_user_id") @db.Uuid
  rewardPoints   Int      @default(0) @map("reward_points")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  referrer User @relation("ReferrerRelation", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referred User @relation("ReferredRelation", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@unique([referredUserId], map: "uq_referred_user_once")
  @@index([referrerUserId])
  @@map("referrals")
}

model Subscription {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String             @map("user_id") @db.Uuid
  subscriptionType String             @map("subscription_type") @db.VarChar(64) // e.g. "ELVIORA_INSIDER_ANNUAL"
  startDate        DateTime           @map("start_date") @db.Timestamptz
  endDate          DateTime?          @map("end_date") @db.Timestamptz
  status           SubscriptionStatus @default(ACTIVE)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([endDate])
  @@map("subscriptions")
}

// =============================================================================
//  AI SKINCARE ASSISTANT
// =============================================================================

/// Captured assessment from the AI concierge — feeds personalization.
/// `concerns` and `recommendations` are JSON for flexibility as the model
/// evolves; promote to relational tables when shape stabilizes.
model AiSkinAssessment {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String?  @map("user_id") @db.Uuid
  /// Lead email for guest quiz-takers (no account) — makes them a reachable
  /// marketing segment / Meta Custom Audience seed.
  email           String?  @db.VarChar(255)
  skinType        String?  @map("skin_type") @db.VarChar(32) // e.g. "oily", "combination"
  concerns        Json?
  recommendations Json?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([email])
  @@map("ai_skin_assessments")
}

// =============================================================================
//  SYSTEM — Settings (KV store)
// =============================================================================

model Setting {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @unique @db.VarChar(120)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("settings")
}
